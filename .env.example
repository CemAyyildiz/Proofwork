# Copy to .env and fill in. Never commit .env. All keys below are TESTNET only.

# --- Database (Neon Postgres) ---
DATABASE_URL=postgresql://user:password@host/proofwork?sslmode=require

# --- Stellar network ---
STELLAR_NETWORK=testnet
HORIZON_URL=https://horizon-testnet.stellar.org
USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5

# --- Trustless Work (Core API v1, testnet host) ---
TW_BASE_URL=https://dev.api.trustlesswork.com
TW_API_KEY=

# --- Server signing keys (generate with: pnpm keys:gen) ---
# platform admin: appends milestones (escrow role: admin)
PLATFORM_ADMIN_SECRET=
# platform ops: marks milestones delivered (escrow role: serviceProvider)
PLATFORM_OPS_SECRET=
# decision ledger: writes rubric outcomes on-chain (manage_data + memo_hash)
DECISION_LEDGER_SECRET=

# --- Sessions ---
# 32+ random bytes, base64. Generate: openssl rand -base64 48
SESSION_SECRET=

# --- Rate limiting (Upstash Redis). Optional in development; required in production. ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Spike / integration tests only (never used by the app) ---
FUNDER_SECRET=
DISPUTE_RESOLVER_SECRET=

# Default dispute resolver offered in the campaign form (chapter lead key). Optional.
DEFAULT_DISPUTE_RESOLVER_PUBKEY=

# Faucet accounts besides Friendbot whose wallets are not flagged for sharing a
# funding source. Comma-separated public keys (G...). Optional.
PUBLIC_FUNDING_SOURCES=

# --- Sign in with X (OAuth 2.0, confidential client). Optional: set all three or none. ---
# Without them the Connect X step is shown as "Not available yet". See docs/deployment.md.
X_CLIENT_ID=
X_CLIENT_SECRET=
# Must equal a callback URL registered on the X app, e.g. http://localhost:3000/api/x/callback
X_REDIRECT_URI=
