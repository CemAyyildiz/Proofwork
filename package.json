{
  "name": "proofwork",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:testnet": "PROOFWORK_TESTNET=1 vitest run tests/testnet",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "keys:gen": "tsx scripts/gen-testnet-keys.ts",
    "spike": "node --env-file=.env --import tsx scripts/escrow-spike.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "accounts:prepare": "node --env-file=.env --import tsx scripts/prepare-testnet-accounts.ts",
    "escrow:close": "node --env-file=.env --import tsx scripts/close-escrow.ts",
    "role:grant": "node --env-file=.env --import tsx scripts/grant-role.ts",
    "results": "tsx scripts/results.ts",
    "evidence:dump": "node --env-file=.env --import tsx scripts/evidence-dump.ts"
  },
  "dependencies": {
    "@creit.tech/stellar-wallets-kit": "^2.6.0",
    "@stellar/stellar-sdk": "^14.6.1",
    "@upstash/ratelimit": "^2.1.0",
    "@upstash/redis": "^1.39.0",
    "drizzle-orm": "^0.45.3",
    "next": "16.3.6",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22.12"
  }
}
