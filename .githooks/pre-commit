#!/usr/bin/env bash
# Block secrets, forbidden files and stray Markdown from being committed.
set -euo pipefail
fail=0
files="$(git diff --cached --name-only --diff-filter=ACMR)"
[ -z "$files" ] && exit 0

while IFS= read -r f; do
  case "$f" in
    CLAUDE.md|CLAUDE.local.md|AGENTS.md|.claude/*|_bmad/*|_bmad-output/*|*.docx)
      echo "pre-commit: '$f' must not be committed." >&2; fail=1 ;;
    .env|.env.*)
      [ "$f" != ".env.example" ] && { echo "pre-commit: env file '$f' must not be committed." >&2; fail=1; } ;;
    *.md)
      case "$f" in
        README.md|docs/*) ;;
        *) echo "pre-commit: Markdown outside README.md and docs/ is not allowed: '$f'." >&2; fail=1 ;;
      esac ;;
  esac
done <<< "$files"

# Secret patterns in staged content (Stellar secret seeds, private keys, common API tokens).
if git diff --cached -U0 | grep -E '^\+' | grep -Ev '^\+\+\+' | grep -Eq \
   -e 'S[A-Z2-7]{55}' \
   -e '-----BEGIN (RSA |EC |OPENSSH )?PRIVATE KEY-----' \
   -e '(api[_-]?key|secret|token|password)["'"'"']?\s*[:=]\s*["'"'"'][A-Za-z0-9_\-]{16,}' \
   -e 'sk_(live|test)_[A-Za-z0-9]{16,}' \
   -e 'ghp_[A-Za-z0-9]{36}'; then
  echo "pre-commit: possible secret in staged changes. Remove it before committing." >&2
  fail=1
fi

# Personal email must not land in the repo. Only SHA-256 hashes of the
# lowercased addresses are stored here, so the hook itself does not leak them.
blocked_email_hashes="4488f5bceb88c46aa16a24f05c64013431d2ef44a43b9a76fa17176647af942f 77872b0de5d70924e73b2a9deaad7586c1114d300e3f9c0d87156a9b2ab2ba4f"
while IFS= read -r addr; do
  [ -z "$addr" ] && continue
  h="$(printf %s "$addr" | tr '[:upper:]' '[:lower:]' | shasum -a 256 | cut -c1-64)"
  case " $blocked_email_hashes " in
    *" $h "*) echo "pre-commit: personal email address in staged changes." >&2; fail=1 ;;
  esac
done < <(git diff --cached -U0 | grep -E '^\+' | grep -Ev '^\+\+\+' | grep -oE '[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}' | sort -u)


# Type safety gate: never commit code that does not compile.
if [ "$fail" -eq 0 ] && git diff --cached --name-only | grep -qE '\.(ts|tsx)$'; then
  pnpm -s typecheck || { echo "pre-commit: typecheck failed." >&2; fail=1; }
  pnpm -s lint || { echo "pre-commit: lint failed." >&2; fail=1; }
fi
exit $fail
